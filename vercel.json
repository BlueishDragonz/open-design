{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "OD_WEB_OUTPUT_MODE= pnpm --filter @open-design/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/out",
  "framework": null,
  "redirects": [
    {
      "source": "/:path((?!api/|artifacts/|frames/|_next/)[^/]+(?:/[^/]+)*)/",
      "destination": "/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://hermes-vnic-1.taila8a61a.ts.net/api/:path*" },
    { "source": "/artifacts/:path*", "destination": "https://hermes-vnic-1.taila8a61a.ts.net/artifacts/:path*" },
    { "source": "/frames/:path*", "destination": "https://hermes-vnic-1.taila8a61a.ts.net/frames/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
